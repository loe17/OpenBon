datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model EventConfig {
  id                            String   @id @default("default")
  name                          String   @default("Vereinsfest 2026")
  currency                      String   @default("EUR")
  taxRateNormal                 Float    @default(19.0)
  taxRateReduced                Float    @default(7.0)
  trainingMode                  Boolean  @default(false)
  trayMaxItems                  Int      @default(6)   // Globales Tablett-Limit (Fallback fuer Druckgruppen)
  adminPin                      String   @default("1234")
  posPin                        String   @default("1111")
  kitchenPin                    String   @default("2222")
  waiterPin                     String   @default("3333")
  enableVirtualPrinters         Boolean  @default(false)
  enableTax                     Boolean  @default(false) // Standardmäßig deaktiviert (Vereine/Kleinunternehmer)
  
  // V2/V3 Schalter & Features
  enableCourses                 Boolean  @default(false)
  enableDigitalReceipt          Boolean  @default(false)
  enableAgeVerificationAlerts   Boolean  @default(true)
  enableDigitalReceiptQr        Boolean  @default(false)
  enableGuestSelfOrder          Boolean  @default(false) // Standardmäßig deaktiviert
  enableGuestFacingDisplay      Boolean  @default(false) // Gastansicht beim Kassieren standardmäßig deaktiviert
  enableKioskMode               Boolean  @default(false)
  activeTheme                   String   @default("dark") // dark, light, contrast, modern, minimal, plain
  lowStockAlertPrinterId        String?

  // Beleg- & Bon-Druck Layout
  receiptHeader                 String?  @default("Vereinsfest 2026")
  receiptSubHeader              String?  @default("Freiwillige Feuerwehr e.V.")
  receiptFooterText             String?  @default("Vielen Dank für Ihren Besuch!")
  receiptShowTimestamp          Boolean  @default(true)
  receiptShowWaiter             Boolean  @default(true)
  receiptShowTable              Boolean  @default(true)
  receiptShowTse                Boolean  @default(true)
  receiptTableFontSize          Int      @default(3) // Stufenlose Skalierung
  receiptSingleItemKitchenSlips Boolean  @default(true) // Legacy Fallback
  receiptSingleItemFoodSlips    Boolean  @default(true) // Einzelbon fuer Speisen (Kueche)
  receiptSingleItemDrinkSlips   Boolean  @default(true) // Einzelbon fuer Getraenke (Ausschank)
  receiptFoodShowHeader         Boolean  @default(true)
  receiptFoodShowTable          Boolean  @default(true)
  receiptFoodShowWaiter         Boolean  @default(true)
  receiptFoodShowTimestamp      Boolean  @default(true)
  receiptFoodShowOptions        Boolean  @default(true)
  receiptDrinkShowHeader        Boolean  @default(true)
  receiptDrinkShowTable         Boolean  @default(true)
  receiptDrinkShowWaiter        Boolean  @default(true)
  receiptDrinkShowTimestamp     Boolean  @default(true)
  receiptDrinkShowOptions       Boolean  @default(true)

  // Kartenzahlungs-IDs
  sumupMerchantCode             String?
  sumupAppId                    String?
  vrPayTerminalId               String?
  sparkasseMerchantId           String?  // S-POS Haendler-/Filial-ID
  zvtHost                       String?  // ZVT-over-IP Terminal (Sparkasse / klassisches EC-Terminal)
  zvtPort                       Int      @default(20007)
  zvtPassword                   String   @default("000000")
  baseUrl                       String   @default("http://openbon.local") // Basis fuer App-to-App Callbacks
  
  // Fiskalisierung & DATEV
  tseProvider                   String   @default("NONE") // NONE, SWISSBIT_USB, FISKALTRUST_CLOUD
  tseSerialNumber               String?
  datevConsultantNumber         String?
  datevClientNumber             String?
  datevCashAccount              String   @default("1000")

  // Hochverfuegbarkeit & Lizenz & Sicherheit
  sessionSecret                 String?  // Kryptografischer Secret-Schlüssel für signierte JWT-Session-Cookies
  haSyncSecret                  String?  @default("openbon-ha-sync-secret-2026")
  licenseKey                    String   @default("OPENBON-COMMUNITY-FREE")
  haRole                        String   @default("PRIMARY") // PRIMARY, STANDBY
  haPartnerUrl                  String?  @default("http://192.168.1.101:3000")
  haAutoFailover                Boolean  @default(true)
  tokenSequence                 Int      @default(1)
  invoiceSequence               Int      @default(1)
  orderSequence                 Int      @default(1)
  updatedAt                     DateTime @updatedAt
  createdAt                     DateTime @default(now())
}

model TipProfile {
  id                  String          @id @default(cuid())
  name                String          // z. B. "Standard Service (100%)", "Bar-Team (20% Pool)"
  waiterPercent       Float           @default(100.0) // Default: 100% an Bedienung
  barPoolPercent      Float           @default(0.0)
  kitchenPoolPercent  Float           @default(0.0)
  servicePoolPercent  Float           @default(0.0)
  isDefault           Boolean         @default(false)
  waiters             WaiterProfile[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model WaiterProfile {
  id           String      @id @default(cuid())
  name         String      @unique
  pin          String      @default("3333")
  isActive     Boolean     @default(true)
  tipProfileId String?
  tipProfile   TipProfile? @relation(fields: [tipProfileId], references: [id], onDelete: SetNull)
  orders       Order[]
  payments     Payment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  sortIndex Int       @default(0)
  color     String?   @default("#3b82f6")
  icon      String?   @default("Utensils")
  products  Product[]
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  alternativeTicketName String?
  price                 Float             @default(0.0)
  deposit               Float             @default(0.0)
  taxRate               Float             @default(19.0)
  buttonColor           String?           @default("#3b82f6")
  status                String            @default("ACTIVE") // ACTIVE, INACTIVE, HIDDEN
  isSoldOut             Boolean           @default(false)
  
  // Bestandsfuehrung & Mindestmengen-Alerts
  trackStock            Boolean           @default(false)
  stockQuantity         Int               @default(0)
  minStockAlert         Int?              // Meldebestand fuer Warnung
  minStockAlertPrinted  Boolean           @default(false)
  stockAlertThreshold   Int               @default(10)
  
  // Jugendschutz & Alterspruefung
  hasAgeRestriction     Boolean           @default(false)
  minAge                Int?              // 16, 18

  // Allergene & Zusatzstoffe (LMIV)
  allergens             String            @default("[]") // JSON Array z. B. ["GLUTEN", "MILCH"]
  additives             String            @default("[]") // JSON Array z. B. ["KOFFEIN", "FARBSTOFF"]

  // Happy Hour & Dynamische Preise
  happyHourPrice        Float?
  happyHourStart        String?           // z. B. "18:00"
  happyHourEnd          String?           // z. B. "19:00"
  happyHourDays         String            @default("[]") // JSON Array [1,2,3,4,5]

  // Wertmarken-Klassifizierung
  isTokenProduct        Boolean           @default(false)
  tokenType             String?           // DRINK, FOOD, DEPOSIT, GENERAL

  subCategory           String?           // BIER, WEIN, ALKOHOLFREI, HEISS, BAR, SPEISE
  sortIndex             Int               @default(0)
  categoryId            String
  category              ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants              ProductVariant[]
  options               ProductOption[]
  printGroupId          String?
  printGroup            PrintGroup?       @relation(fields: [printGroupId], references: [id], onDelete: SetNull)
  stockItem             StockItem?
  orderItems            OrderItem[]
  tapLines              TapLine[]

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float    @default(0.0)
  isSoldOut  Boolean  @default(false)
  sortIndex  Int      @default(0)

  @@index([productId])
}

model ProductOption {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float    @default(0.0)
  sortIndex  Int      @default(0)

  @@index([productId])
}

model CustomizationWordGroup {
  id        String   @id @default(cuid())
  name      String
  words     String   // JSON-Array: ["ohne", "extra", "wenig", "viel"]
  sortIndex Int      @default(0)
}

model DiningTable {
  id               String    @id @default(cuid())
  tableNumber      Int       @unique
  label            String
  section          String    @default("Hauptbereich")
  gridX            Int       @default(0)
  gridY            Int       @default(0)
  status           String    @default("FREE") // FREE, OCCUPIED, BILL_REQUESTED, HIDDEN, INACTIVE
  isActive         Boolean   @default(true)
  activeWaiterName String?
  qrToken          String?   // Token fuer Gast-QR-Bestellung
  orders           Order[]
  payments         Payment[]

  @@index([isActive])
  @@index([status])
}

model Printer {
  id           String       @id @default(cuid())
  name         String
  ipAddress    String       @default("127.0.0.1")
  port         Int          @default(9100)
  paperWidth   Int          @default(80)
  characterSet String       @default("CP858")
  isVirtual    Boolean      @default(false)
  isActive     Boolean      @default(true)
  printGroups  PrintGroup[]
}

model PrintGroup {
  id                String    @id @default(cuid())
  name              String
  printerId         String?
  printer           Printer?  @relation(fields: [printerId], references: [id], onDelete: SetNull)
  maxItemsPerTicket Int       @default(0) // 0 = unbegrenzt, 1 = Einzelbons
  autoCut           Boolean   @default(true)
  products          Product[]
}

model Order {
  id                 String         @id @default(cuid())
  orderNumber        Int            @default(1)
  tableId            String?
  table              DiningTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiterId           String?
  waiter             WaiterProfile? @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  waiterName         String         @default("Bedienung")
  deviceId           String?
  source             String         @default("WAITER") // WAITER, GUEST_QR, KIOSK
  status             String         @default("OPEN")   // OPEN, IN_PREPARATION, READY, COMPLETED, CANCELLED
  orderType          String         @default("TABLE")  // TABLE, COUNTER_VOUCHER, COUNTER_DIRECT, KIOSK
  tokenNumber        Int?
  digitalReceiptCode String?        @unique
  isTraining         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  items              OrderItem[]
  payments           Payment[]

  @@index([tableId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName       String
  quantity          Int           @default(1)
  unitPrice         Float
  deposit           Float         @default(0.0)
  taxRate           Float         @default(19.0)
  variantName       String?
  selectedOptions   String?       // JSON Array String
  customizationText String?
  courseNumber      Int           @default(1)     // Gang 1 = Vorspeise, 2 = Hauptgang, 3 = Dessert
  isHold            Boolean       @default(false) // Zurueckhalten bis manueller Postenabruf
  printStatus       String        @default("PENDING") // PENDING, HELD, PRINTED, ERROR
  kdsStatus         String        @default("PENDING") // PENDING, IN_PROGRESS, READY, COMPLETED
  kdsCompletedAt    DateTime?
  paidQuantity      Int           @default(0)
  isCancelled       Boolean       @default(false) // = isVoided (Storno)
  cancellationReason String?                      // = voidReason (Stornogrund)
  cancelledBy       String?
  cancelledAt       DateTime?
  paymentItems      PaymentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([isCancelled])
}

model Payment {
  id                 String          @id @default(cuid())
  invoiceNumber      String          @unique
  tableId            String?
  table              DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  periodId           String?
  period             RegisterPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  waiterId           String?
  waiter             WaiterProfile?  @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  waiterName         String
  deviceId           String?
  digitalReceiptCode String?         @unique
  totalGross         Float
  totalNet           Float
  totalTax           Float
  taxBase19          Float           @default(0.0) // Netto-Bemessungsgrundlage 19 %
  taxAmount19        Float           @default(0.0)
  taxBase7           Float           @default(0.0) // Netto-Bemessungsgrundlage 7 %
  taxAmount7         Float           @default(0.0)
  taxBase0           Float           @default(0.0) // Steuerfrei (z. B. Pfand)
  totalDeposit       Float           @default(0.0)
  returnDeposit      Float           @default(0.0)
  discountAmount     Float           @default(0.0)
  tipAmount          Float           @default(0.0)
  tipWaiterShare     Float           @default(0.0)
  tipPoolShare       Float           @default(0.0)
  surchargeAmount    Float           @default(0.0)
  surchargePercent   Float           @default(0.0)
  surchargeReason    String?
  givenAmount        Float           @default(0.0)
  changeAmount       Float           @default(0.0)
  // CASH, CARD_SUMUP, CARD_VRPAY, CARD_SPARKASSE, CARD_TERMINAL, TOKEN,
  // NON_PAID_STAFF, NON_PAID_COMPLAINT, VOID_UNPAID, DISCOUNT
  paymentMethod      String          @default("CASH")
  cardAuthCode       String?         // Autorisierungscode Terminal / App
  cardTerminalId     String?
  nonPaidReason      String?
  isCancelled        Boolean         @default(false)
  cancellationReason String?
  isTraining         Boolean         @default(false)
  createdAt          DateTime        @default(now())
  items              PaymentItem[]

  @@index([tableId])
  @@index([orderId])
  @@index([createdAt])
  @@index([isCancelled])
}

model PaymentItem {
  id          String     @id @default(cuid())
  paymentId   String
  payment     Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Float
  deposit     Float      @default(0.0)
  taxRate     Float      @default(19.0)
}

model TokenTransaction {
  id          String   @id @default(cuid())
  tokenType   String   @default("GENERAL") // DRINK, FOOD, DEPOSIT, GENERAL
  action      String   // ISSUE, REDEEM, RETURN
  quantity    Int
  unitValue   Float
  totalValue  Float
  waiterName  String   @default("Kasse")
  deviceId    String?
  createdAt   DateTime @default(now())
}

model FiscalExport {
  id             String   @id @default(cuid())
  exportType     String   // DATEV_CASHBOOK, DSFINVK_TAR, TSE_AUDIT
  periodStart    DateTime
  periodEnd      DateTime
  filename       String
  checksumSha256 String
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
}

model StockItem {
  id               String   @id @default(cuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  initialQuantity  Int      @default(100)
  currentQuantity  Int      @default(100)
  alertThreshold   Int      @default(10)
  isAutoDeactivate Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model ChatMessage {
  id             String   @id @default(cuid())
  senderName     String
  senderDeviceId String?
  targetDeviceId String?  // null = Broadcast an alle
  message        String
  isUrgent       Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Device {
  id           String   @id // Client UUID
  name         String
  role         String   @default("WAITER") // ADMIN, WAITER, POS_CASHIER, KITCHEN
  ipAddress    String?  @default("127.0.0.1")
  userAgent    String?
  batteryLevel Float?   @default(100.0)
  isCharging   Boolean? @default(false)
  status       String   @default("ONLINE") // ONLINE, IDLE, OFFLINE
  connectedAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
}

// Kassenperiode: wird durch den Z-Bon (Tagesabschluss) geschlossen
model RegisterPeriod {
  id               String        @id @default(cuid())
  periodNumber     Int
  openedAt         DateTime      @default(now())
  closedAt         DateTime?
  status           String        @default("OPEN") // OPEN, CLOSED
  closedBy         String?
  // Fiskalblock: Snapshot der Kennzahlen zum Abschlusszeitpunkt
  totalGross       Float         @default(0.0)
  totalNet         Float         @default(0.0)
  taxAmount19      Float         @default(0.0)
  taxAmount7       Float         @default(0.0)
  taxBase0         Float         @default(0.0)
  totalCash        Float         @default(0.0)
  totalCard        Float         @default(0.0)
  totalTips        Float         @default(0.0)
  totalDepositOut  Float         @default(0.0)
  cashIn           Float         @default(0.0)
  cashOut          Float         @default(0.0)
  cashExpected     Float         @default(0.0)
  cashCounted      Float?
  cashDifference   Float?
  transactionCount Int           @default(0)
  fiscalSignature  String?       // HMAC-SHA256 ueber den Abschlussblock
  reportJson       String?       // Vollstaendiger Z-Bon als JSON-Snapshot
  payments         Payment[]
  cashMovements    CashMovement[]
}

// Kassenbuch: Wechselgeld-Einlagen und Entnahmen in den Tresor
model CashMovement {
  id          String          @id @default(cuid())
  periodId    String?
  period      RegisterPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  type        String          @default("CASH_IN") // CASH_IN, CASH_OUT
  amount      Float
  reason      String
  waiterName  String          @default("Kasse")
  deviceId    String?
  isTraining  Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

// Ergebnisse der zyklischen Selbstdiagnose (Self-Healing)
model DiagnosticRun {
  id           String   @id @default(cuid())
  status       String   @default("OK") // OK, WARNING, ERROR
  checksJson   String   // JSON-Array der Einzelpruefungen
  repairsCount Int      @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())
}

model SyncJournal {
  id         Int      @id @default(autoincrement())
  entityType String   // ORDER, PAYMENT, PRODUCT, TABLE, etc.
  entityId   String
  operation  String   // INSERT, UPDATE, DELETE
  payload    String   // JSON Snapshot
  createdAt  DateTime @default(now())
}

// Schank- & Fassüberwachung (Bierfässer, Premix, Schankverlust)
model TapLine {
  id                  String   @id @default(cuid())
  tapNumber           Int      @default(1)
  name                String   // z. B. "Hahn 1 - Helles Festbier"
  kegVolumeLiters     Float    @default(50.0)
  currentVolumeLiters Float    @default(50.0)
  portionSizeLiters   Float    @default(0.5)
  lossPercentage      Float    @default(3.0) // Schankverlust in % (Schaum/Zapfverlust)
  warningLevelPercent Float    @default(10.0) // Warnung bei unter X %
  kegsTapped          Int      @default(1)    // Anzahl angeschlagener Fässer heute
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

// System- und Revisionsprotokoll (Audit-Log aller Aktionen)
model ActionLog {
  id        String   @id @default(cuid())
  action    String   // ORDER_CREATED, ITEM_VOIDED, PAYMENT_COMPLETED, SHIFT_SETTLED, CASH_MOVEMENT, CONFIG_CHANGED, DIAGNOSTICS_RUN, TABLE_TRANSFERRED, SYSTEM_EVENT
  category  String   @default("GENERAL") // SALES, ORDERS, AUTH, CASHBOOK, SYSTEM, ADMIN
  actor     String   @default("System")  // Waiter Name, Admin, POS Station ID
  details   String   // Human readable description
  metadata  String?  // JSON metadata string
  createdAt DateTime @default(now())

  @@index([action])
  @@index([category])
  @@index([createdAt])
}

// Persistente Druck-Warteschlange (Druckerspooler-Resilienz)
model PrintJob {
  id             String    @id @default(cuid())
  printerId      String?
  printGroupId   String?
  orderId        String?
  title          String?
  status         String    @default("PENDING") // PENDING, PRINTING, PRINTED, FAILED
  sequenceNumber Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  rawPayload     String?   // Base64 oder formatierter ESC/POS Text
  createdAt      DateTime  @default(now())
  printedAt      DateTime?

  @@index([status, createdAt])
  @@index([printerId])
  @@index([printGroupId])
}

// Idempotenz-Schlüssel zur Verhinderung von Doppelbestellungen/-Zahlungen bei Netzwerkabbrüchen
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  endpoint     String
  statusCode   Int      @default(200)
  responseJson String
  createdAt    DateTime @default(now())

  @@index([key, endpoint])
}

// Dynamische Auswahllisten (Unterkategorien, Pfandstufen, Aufschläge, Stornogründe, etc.)
model ConfigList {
  id        String   @id @default(cuid())
  key       String   @unique // z.B. "SUB_CATEGORIES", "DEPOSIT_TIERS", "TIP_PRESETS", "VOID_REASONS", "COURSE_NAMES"
  name      String
  itemsJson String   // JSON array
  updatedAt DateTime @updatedAt
}

// Veranstaltungsvorlagen (Snapshots zur schnellen Wiederverwendung)
model EventProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  profileJson String   // JSON Snapshot
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Personalverwaltung mit Rollen & PIN-Hashes
model Staff {
  id        String   @id @default(cuid())
  name      String   @unique
  role      String   @default("WAITER") // ADMIN, WAITER, POS_CASHIER, KITCHEN
  pinHash   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
