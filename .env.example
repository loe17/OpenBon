# OpenBon Konfigurations-Umgebungsvariablen
# Einheitlicher DB-Pfad (muss zu litestream.yml + backup-scheduler passen)
DATABASE_URL="file:./prisma/dev.db"
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"
HA_ROLE="PRIMARY"
HA_PARTNER_URL=""

# Optional: fixes JWT session secret (otherwise automatically generated & stored in DB)
# SESSION_SECRET="change-me-at-least-16-characters"
# Fiskal-Signatur (min. 16 Zeichen, Pflicht für Z-Bon-Signatur)
# FISCAL_SALT="bitte-mindestens-16-zeichen-lang"
# Backup-Ziel off-device (USB/NAS), z. B. /mnt/usb/openbon-backups
# BACKUP_DIR="./prisma/backups"
# BACKUP_KEEP="10"
# HA: Secret-Pflicht (empfohlen) + Kalt-Standby (kein Auto-Failover)
# HA_SYNC_SECRET="bitte-einmalig-pairen-mind-32-zeichen"
# HA_ENFORCE_SECRET="1"
# HA_AUTO_FAILOVER="0"
# Nur für Upgrade-Fenster alter Doppelinstallationen:
# HA_ALLOW_LEGACY="0"
# TSE (Default NONE = ehrlich ohne TSE; MOCK = File-Log ohne Hardware)
# TSE_PROVIDER="NONE"
# FISKALY_API_KEY=""
# FISKALY_TSS_ID=""
# FISKALY_BASE_URL="https://kassensicherungsverordnung.fiskaly.com/api/v2"
# DATEV-Konten (Defaults 1000/8400/8300/8200/1360)
# DATEV_CASH_ACCOUNT="1000"
# E-Bon-Schlüssel (Pflicht, min. 16 Zeichen – kein Public-Fallback)
# LICENSE_HMAC_SECRET="bitte-mindestens-16-zeichen-lang"
